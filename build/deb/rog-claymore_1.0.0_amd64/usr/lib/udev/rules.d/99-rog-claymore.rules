# rog-claymore-linux
#
# Grants members of the plugdev group access to the ASUS ROG Claymore keyboard
# so the lighting can be driven without root.
#
# Install with:
#     sudo cp udev/99-rog-claymore.rules /etc/udev/rules.d/
#     sudo udevadm control --reload-rules
#     sudo udevadm trigger
#
# Then unplug and replug the keyboard, or log out and back in.
#
# 0b05:184d is the original ROG Claymore. The Aura control collection lives on
# interface 1, and this rule matches every interface of that product so the
# tool works even on a unit that exposes the collection elsewhere.

# Original ASUS ROG Claymore
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="184d", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Same access by way of the USB device, which also covers the detachable
# numpad presenting itself as a separate interface.
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="184d", MODE="0660", GROUP="plugdev", TAG+="uaccess"
