[Desktop Entry]
Type=Application
Version=1.0
Name=ROG Claymore
GenericName=Keyboard lighting
Comment=Light effects and per-key designs for the ASUS ROG Claymore
Exec=claymore-gui
TryExec=claymore-gui
Icon=rog-claymore
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=keyboard;rog;asus;aura;rgb;lighting;backlight;claymore;
StartupNotify=true

# The file is named after the application id, org.claymore.linux, because that
# is what the window reports about itself: the desktop looks for
# <application id>.desktop to decide what a window is, and so which icon the
# task bar shows.
#
# StartupWMClass is the belt to that pair of braces. Desktops that match on the
# window class instead - Xfce, KDE, Cinnamon - find it that way. GTK sets the
# class from the program name, so it is the binary's name with a capital letter.
StartupWMClass=Claymore-gui

# 'make install' puts this file, the icon named above and the two binaries
# where they belong. To do it by hand for one user instead:
#
#     install -Dm644 contrib/org.claymore.linux.desktop \
#         ~/.local/share/applications/org.claymore.linux.desktop
#     install -Dm644 assets/rog-claymore.svg \
#         ~/.local/share/icons/hicolor/scalable/apps/rog-claymore.svg
#     update-desktop-database ~/.local/share/applications 2>/dev/null || true
